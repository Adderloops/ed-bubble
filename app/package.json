{
  "name": "ed-bubble-app",
  "version": "0.7.0-beta.3",
  "description": "ED BUBBLE: ventana de Windows para Elite Dangerous con datos en vivo del Journal.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "stage": "node scripts/stage.js",
    "dist": "node scripts/stage.js && electron-builder --win --x64 --dir && node scripts/make-installer.js"
  },
  "author": "Adder",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "com.adder.edbubble",
    "productName": "ED BUBBLE",
    "copyright": "© Adder · GPLv3",
    "directories": {
      "app": "dist/stage",
      "output": "dist/release",
      "buildResources": "build"
    },
    "files": [
      "**/*"
    ],
    "asarUnpack": [
      "core/keysender.ps1"
    ],
    "afterPack": "./scripts/after-pack.js",
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "electronLanguages": [
      "es",
      "en-US"
    ]
  }
}
